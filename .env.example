# ================================================================
# RCY RECOVERY MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# ================================================================

# Database
DATABASE_URL=sqlite:///recovery_manager.db
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require

# Storage (Cloudinary + Local Fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI & LLM Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Security, Auth & Tenancy
# Set REQUIRE_AUTH=true in production/deployment. If true, AGENT_API_KEY is strictly required.
REQUIRE_AUTH=false

# Agent API Key (Matched via header X-API-Key on all protected routes)
# Required when REQUIRE_AUTH=true. Fail-fast on startup if missing.
AGENT_API_KEY=rcy-recovery-manager-agent-api-key-2026

# Optional legacy secret key for internal session tokens
SECRET_KEY=rcy-recovery-manager-super-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Multi-Tenancy Allowed Organizations (Comma-separated)
# Matches pod sample data and fixtures (org_demo_alpha, org_demo_bravo).
# Add any additional organization IDs here for deployment scoping.
ALLOWED_ORGS=org_demo_alpha,org_demo_bravo
